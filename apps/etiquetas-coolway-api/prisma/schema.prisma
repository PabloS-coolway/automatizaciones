generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Maestro de referencias Coolway (fuente de verdad de los códigos de barra).
/// Una fila por SKU = (ref, size). Solo la app escribe; los consumidores leen.
model Reference {
  id           Int      @id @default(autoincrement())
  style        String
  color        String
  ref          String
  size         String
  sku          String
  /// REQ-003 · Un SKU tiene hasta TRES tallas y confundirlas imprime el código de otro producto:
  /// `size` es la que se IMPRIME (40 · S · 36-38 · U), `tallaSap` la que viene en el PDF del pedido
  /// (40 · 31 · C01) y `tallaTiendas` la que va al CÓDIGO DE BARRAS (40 · 11 · 35).
  /// En calzado las tres coinciden y estas dos van vacías.
  tallaSap     String?  @map("talla_sap")
  tallaTiendas String?  @map("talla_tiendas")
  /// El EAN13 NO es único: un producto re-referenciado en SAP conserva su código en la ref vieja
  /// y en la nueva (mismo modelo+color, dos refs). La identidad del SKU es (ref, size).
  /// Si un mismo EAN aparece en productos DISTINTOS, es un error del maestro: la carga lo AVISA
  /// (no lo rechaza) para que se corrija en origen. Ver SeedMasterUseCase.
  ean13        String?
  upc          String?
  colorNameWeb String?  @map("color_name_web")
  /// REQ-009 · Si el "color web" se editó a mano desde la web, deja de ser dueño el Excel: la
  /// reimportación NO lo pisa. `manual=true` marca esa fila; editedBy/At dejan el rastro de quién y cuándo.
  colorNameWebManual   Boolean   @default(false) @map("color_name_web_manual")
  colorNameWebEditedBy String?   @map("color_name_web_edited_by")
  colorNameWebEditedAt DateTime? @map("color_name_web_edited_at")
  season       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([ref, size]) // un SKU por talla de cada referencia
  @@index([style, color])
  @@index([ean13]) // se consulta por código, pero sin exigir unicidad
  @@map("reference")
}

/// REQ-004 · Destino de un pedido. Decide QUÉ CÓDIGOS lleva la etiqueta (`variant`) y el texto
/// "importado por" que se imprime. Es una decisión COMERCIAL de Yorga (RF-13/RF-14), no un dato de SAP
/// ni del maestro: por eso vive aquí y lo gobierna la app.
/// Se DESACTIVA, no se borra: así el histórico y los pedidos antiguos siguen teniendo sentido.
model Destination {
  id           Int      @id @default(autoincrement())
  /// Lo que se elige al generar (VALENCIA, USA…). En mayúsculas, único.
  code         String   @unique
  /// Nombre legible para la pantalla ("Costa Rica").
  name         String
  /// Una de las variantes que el motor sabe construir: EAN | UPC | CODE128_EAN | UPC_EAN.
  /// NO es texto libre: si no, el generador no sabría qué imprimir. Se valida en el dominio.
  variant      String
  /// Texto que se imprime en la columna "importado por" (razón social o cliente/país).
  importadoPor String   @map("importado_por")
  /// Un destino inactivo no aparece al generar, pero no se pierde.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("destination")
}

/// REQ-006 · Rol como DATO gobernable (antes era un enum fijo `operador|admin`). Decide qué FEATURES tiene
/// un usuario. `operador` y `admin` son roles de SISTEMA (system=true): no se borran. Se pueden crear más
/// desde el panel. El catálogo de features es cerrado y vive en código (@yorga/contracts · FEATURES).
model Role {
  id        Int      @id @default(autoincrement())
  /// Clave estable e identidad del rol: operador, admin, contable…
  key       String   @unique
  name      String
  /// Features que tiene el rol (subconjunto del catálogo cerrado).
  features  String[]
  active    Boolean  @default(true)
  /// Roles de sistema (operador/admin): no se borran ni se les cambia la clave.
  system    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]

  @@map("role")
}

/// Usuarios internos de la herramienta. Alta/baja por un admin (no hay registro abierto).
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  /// Clave del rol (FK a role.key). Se conserva la columna `role` de antes.
  role         String   @default("operador")
  roleRef      Role     @relation(fields: [role], references: [key])
  active       Boolean  @default(true)
  /// REQ-008 · Enlace 1:1 con su ficha de empleado (RRHH). El módulo RRHH comparte SÓLO la identidad.
  employee     Employee?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_user")
}

/// REQ-008 · Centro de trabajo (con su marca/enseña). Un empleado pertenece a un centro; el organigrama
/// es multimarca segmentado por marca/centro.
model Center {
  id        Int        @id @default(autoincrement())
  name      String
  /// Marca/enseña del grupo Yorga (COOLWAY, …). Segmenta el organigrama y los permisos.
  brand     String
  employees Employee[]
  holidays  Holiday[]

  @@map("hr_center")
}

/// REQ-008 · Festivo (día no laborable) de un centro, o GLOBAL para todos los centros si `centerId` es null.
/// Las vacaciones se cuentan en días naturales, así que un festivo NO descuenta saldo: es informativo (se
/// pinta en el calendario y ayuda a coordinar). Un festivo se identifica por (fecha, centro): no se repite.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  name      String
  /// `null` = festivo GLOBAL (aplica a todos los centros). Si apunta a un centro, sólo aplica a ese.
  centerId  Int?     @map("center_id")
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, centerId])
  @@index([date])
  @@map("hr_holiday")
}

/// REQ-008 · Departamento (Ventas, Almacén, IT…).
model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]

  @@map("hr_department")
}

/// REQ-008 · Empleado. Dominio RRHH INDEPENDIENTE; comparte con el panel sólo la identidad (`userId` 1:1 con
/// `User`, por correo). `rrhhRole` es el rol DENTRO del módulo (no reutiliza REQ-006). `managerId` sostiene el
/// organigrama y la visibilidad jerárquica. Baja = `active=false` (archiva, no borra).
model Employee {
  id           Int         @id @default(autoincrement())
  /// Identidad compartida: el empleado entra con este usuario del login existente.
  userId       Int         @unique @map("user_id")
  user         User        @relation(fields: [userId], references: [id])
  fullName     String      @map("full_name")
  position     String?
  /// EMPLEADO | MANAGER | RRHH | ADMIN (rol del módulo RRHH, jerárquico).
  rrhhRole     String      @default("EMPLEADO") @map("rrhh_role")
  /// Responsable directo → organigrama automático.
  managerId    Int?        @map("manager_id")
  manager      Employee?   @relation("Org", fields: [managerId], references: [id])
  reports      Employee[]  @relation("Org")
  departmentId Int?        @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  centerId     Int?        @map("center_id")
  center       Center?     @relation(fields: [centerId], references: [id])
  contractType String?     @map("contract_type")
  /// Jornada teórica semanal en minutos (p.ej. 2400 = 40 h/semana). `null` = sin horario definido → no se
  /// computan horas extra. La diaria teórica se deriva repartiendo entre los días laborables (L–V).
  weeklyMinutes Int?       @map("weekly_minutes")
  /// Días de vacaciones que devenga al año (para el saldo). `null` = sin cupo definido.
  annualLeaveDays Int?     @map("annual_leave_days")
  /// Datos bancarios opcionales, preparados para una futura nómina (no se usan en Fase 1).
  iban         String?
  /// Fecha de nacimiento (para los próximos cumpleaños del equipo). Sólo la fecha, sin hora.
  birthDate    DateTime?   @map("birth_date") @db.Date
  /// Privacidad: si el empleado no quiere que su cumpleaños se muestre al equipo. No borra la fecha
  /// (RRHH la necesita), sólo la oculta de los próximos cumpleaños.
  hideBirthday Boolean     @default(false) @map("hide_birthday")
  active       Boolean     @default(true)
  hiredAt      DateTime?   @map("hired_at")
  terminatedAt DateTime?   @map("terminated_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  timeEntries  TimeEntry[]
  absences     Absence[]
  notifications HrNotification[]

  @@index([managerId])
  @@map("hr_employee")
}

/// REQ-008 Fase 4 · Aviso in-app para un empleado (nueva solicitud a aprobar, decisión de su ausencia…). El
/// envío por correo se engancha aquí cuando haya SMTP; de momento es sólo dentro de la app. `readAt` = leído.
model HrNotification {
  id         Int       @id @default(autoincrement())
  employeeId Int       @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id])
  message    String
  link       String?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([employeeId, readAt])
  @@map("hr_notification")
}

/// REQ-008 Fase 3 · Tipo de ausencia configurable (vacaciones, baja médica, permiso, asuntos propios…). Cada
/// tipo define sus reglas: si computa saldo de vacaciones, si requiere aprobación y si exige justificante.
model AbsenceType {
  id               Int       @id @default(autoincrement())
  name             String    @unique
  /// ¿Descuenta del saldo anual de vacaciones? (Fase 3b usa esto para los saldos.)
  computesBalance  Boolean   @default(false) @map("computes_balance")
  /// ¿Necesita aprobación del responsable/RRHH, o es sólo un aviso?
  requiresApproval Boolean   @default(true) @map("requires_approval")
  /// ¿Exige adjuntar justificante? (informativo en Fase 3a).
  requiresAttachment Boolean @default(false) @map("requires_attachment")
  active           Boolean   @default(true)
  absences         Absence[]

  @@map("hr_absence_type")
}

/// REQ-008 Fase 3 · Solicitud de ausencia de un empleado. Estado PENDING → APPROVED/REJECTED. La decisión deja
/// traza (quién, cuándo, nota). Rango de días [startDate, endDate]; `halfDay` = medio día (mismo día).
model Absence {
  id            Int         @id @default(autoincrement())
  employeeId    Int         @map("employee_id")
  employee      Employee    @relation(fields: [employeeId], references: [id])
  typeId        Int         @map("type_id")
  type          AbsenceType @relation(fields: [typeId], references: [id])
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  halfDay       Boolean     @default(false) @map("half_day")
  /// Si es medio día (`halfDay` y un solo día), en qué mitad: FIRST (mañana) | SECOND (tarde). `null` en
  /// ausencias de día completo. Es informativo para el equipo (a efectos de saldo, medio día = 0,5).
  halfDayPart   String?     @map("half_day_part")
  reason        String?
  /// PENDING | APPROVED | REJECTED.
  status        String      @default("PENDING")
  decidedByEmail String?    @map("decided_by_email")
  decidedAt     DateTime?   @map("decided_at")
  decisionNote  String?     @map("decision_note")
  /// Justificante (Fase 3): clave del objeto en el almacenamiento (Spaces/local) y nombre original del fichero.
  /// El fichero se sirve siempre por la API con control de acceso (dato sensible: no hay URL pública).
  attachmentKey  String?    @map("attachment_key")
  attachmentName String?    @map("attachment_name")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([employeeId, startDate])
  @@map("hr_absence")
}

/// REQ-008 Fase 2 · Fichaje (marcaje) de jornada. Registro **solo-añadir**: un fichaje no se edita ni se borra;
/// una corrección se hace insertando un asiento nuevo (Slice 2). La marca de tiempo es del **servidor**
/// (`at @default(now())`), nunca del dispositivo. `kind`: IN | OUT | BREAK_START | BREAK_END.
model TimeEntry {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  /// IN | OUT | BREAK_START | BREAK_END, o VOID (asiento que ANULA otro fichaje, en una corrección).
  kind       String
  /// Sello de tiempo del SERVIDOR (no del dispositivo): es la hora que cuenta.
  at         DateTime @default(now())
  /// Desde dónde se fichó: WEB | MOBILE (informativo), o CORRECTION si lo insertó RRHH.
  source     String   @default("WEB")
  note       String?
  /// Corrección con traza: quién lo insertó (correo). `null` = fichaje propio en vivo del empleado.
  actorEmail String?  @map("actor_email")
  /// Si este asiento ANULA otro (kind=VOID) o lo sustituye, apunta al fichaje corregido. Append-only: no se
  /// edita ni se borra el original; se añade este asiento que lo referencia.
  correctsId Int?     @map("corrects_id")
  /// Geolocalización del fichaje (opcional, con consentimiento del navegador). `accuracy` = radio de precisión
  /// en metros que da el GPS. Sólo se guarda; no se valida contra ningún radio.
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([employeeId, at])
  @@map("hr_time_entry")
}

/// REQ-008 Fase 1 · Log de actividad PROPIO del módulo RRHH (independiente del panel, dato sensible). Append-only:
/// sólo la app escribe, nadie edita ni borra. `before`/`after` guardan el estado antes→después.
model HrActivity {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  /// Quién lo hizo (snapshot del correo del usuario).
  actorEmail String   @map("actor_email")
  action     String // CREATE | UPDATE | DELETE
  entity     String // EMPLEADO | …
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  summary    String

  @@index([createdAt])
  @@map("hr_activity")
}

/// REQ-007 · Log de actividad (auditoría de create/update/delete). **Append-only**: sólo la API escribe,
/// nadie edita ni borra — un log modificable no vale como auditoría. `before`/`after` guardan el estado
/// antes→después (nunca datos sensibles: el hash de contraseña se redacta).
model ActivityEntry {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  /// Quién lo hizo. `actorUserId` puede quedar null si el usuario se borró; el email es un snapshot.
  actorUserId Int?     @map("actor_user_id")
  actorEmail  String   @map("actor_email")
  action      String   // CREATE | UPDATE | DELETE
  entity      String   // USER | ROLE | DESTINATION | MASTER_IMPORT
  entityId    String   @map("entity_id")
  before      Json?    // null en CREATE
  after       Json?    // null en DELETE
  summary     String

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("activity_entry")
}

/// REQ-011 · Catálogo de surtidos por GRUPO de prefijo de referencia (`76` chica / `86` chico, extensible).
/// Al podar (si se activa), se conserva un surtido sólo si su código está en el grupo del prefijo de su
/// familia. Sustituye el modelo por-referencia de REQ-010 Fase 2. Dato del negocio (de Silvia).
model PodaSurtido {
  id        Int      @id @default(autoincrement())
  /// Prefijo de referencia: "76" (chica), "86" (chico)… extensible.
  grupo     String
  /// Código `SURTD` de SAP (3 caracteres, p. ej. `S40`, `00I`).
  codigo    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([grupo, codigo])
  @@map("poda_surtido")
}
