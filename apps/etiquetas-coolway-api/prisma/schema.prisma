generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Maestro de referencias Coolway (fuente de verdad de los códigos de barra).
/// Una fila por SKU = (ref, size). Solo la app escribe; los consumidores leen.
model Reference {
  id           Int      @id @default(autoincrement())
  style        String
  color        String
  ref          String
  size         String
  sku          String
  /// REQ-003 · Un SKU tiene hasta TRES tallas y confundirlas imprime el código de otro producto:
  /// `size` es la que se IMPRIME (40 · S · 36-38 · U), `tallaSap` la que viene en el PDF del pedido
  /// (40 · 31 · C01) y `tallaTiendas` la que va al CÓDIGO DE BARRAS (40 · 11 · 35).
  /// En calzado las tres coinciden y estas dos van vacías.
  tallaSap     String?  @map("talla_sap")
  tallaTiendas String?  @map("talla_tiendas")
  /// El EAN13 NO es único: un producto re-referenciado en SAP conserva su código en la ref vieja
  /// y en la nueva (mismo modelo+color, dos refs). La identidad del SKU es (ref, size).
  /// Si un mismo EAN aparece en productos DISTINTOS, es un error del maestro: la carga lo AVISA
  /// (no lo rechaza) para que se corrija en origen. Ver SeedMasterUseCase.
  ean13        String?
  upc          String?
  colorNameWeb String?  @map("color_name_web")
  season       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([ref, size]) // un SKU por talla de cada referencia
  @@index([style, color])
  @@index([ean13]) // se consulta por código, pero sin exigir unicidad
  @@map("reference")
}

/// REQ-004 · Destino de un pedido. Decide QUÉ CÓDIGOS lleva la etiqueta (`variant`) y el texto
/// "importado por" que se imprime. Es una decisión COMERCIAL de Yorga (RF-13/RF-14), no un dato de SAP
/// ni del maestro: por eso vive aquí y lo gobierna la app.
/// Se DESACTIVA, no se borra: así el histórico y los pedidos antiguos siguen teniendo sentido.
model Destination {
  id           Int      @id @default(autoincrement())
  /// Lo que se elige al generar (VALENCIA, USA…). En mayúsculas, único.
  code         String   @unique
  /// Nombre legible para la pantalla ("Costa Rica").
  name         String
  /// Una de las variantes que el motor sabe construir: EAN | UPC | CODE128_EAN | UPC_EAN.
  /// NO es texto libre: si no, el generador no sabría qué imprimir. Se valida en el dominio.
  variant      String
  /// Texto que se imprime en la columna "importado por" (razón social o cliente/país).
  importadoPor String   @map("importado_por")
  /// Un destino inactivo no aparece al generar, pero no se pierde.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("destination")
}

/// REQ-006 · Rol como DATO gobernable (antes era un enum fijo `operador|admin`). Decide qué FEATURES tiene
/// un usuario. `operador` y `admin` son roles de SISTEMA (system=true): no se borran. Se pueden crear más
/// desde el panel. El catálogo de features es cerrado y vive en código (@yorga/contracts · FEATURES).
model Role {
  id        Int      @id @default(autoincrement())
  /// Clave estable e identidad del rol: operador, admin, contable…
  key       String   @unique
  name      String
  /// Features que tiene el rol (subconjunto del catálogo cerrado).
  features  String[]
  active    Boolean  @default(true)
  /// Roles de sistema (operador/admin): no se borran ni se les cambia la clave.
  system    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]

  @@map("role")
}

/// Usuarios internos de la herramienta. Alta/baja por un admin (no hay registro abierto).
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  /// Clave del rol (FK a role.key). Se conserva la columna `role` de antes.
  role         String   @default("operador")
  roleRef      Role     @relation(fields: [role], references: [key])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_user")
}
