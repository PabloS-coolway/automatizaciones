# Plantilla de configuración de la API.
# Copia este fichero a `.env` (mismo directorio) y ajusta los valores.
# El `.env` real NO se versiona: contiene secretos.
#
#   cp apps/etiquetas-coolway-api/.env.example apps/etiquetas-coolway-api/.env

# --- Base de datos (maestro de códigos) -------------------------------------
# Postgres local vía Docker: `npm run db:up` desde la raíz.
# Credenciales de desarrollo definidas en docker-compose.yml (puerto host 5544).
DATABASE_URL="postgresql://coolway:coolway@localhost:5544/coolway_maestro?schema=public"

# --- Autenticación (JWT) ----------------------------------------------------
# Secreto con el que se firman los tokens de sesión.
# En local, si no se define, la API usa un secreto de desarrollo por defecto.
# OBLIGATORIO al desplegar: genera uno propio y no lo compartas.
#   openssl rand -base64 32
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Caducidad del token (formato `ms`: 12h, 7d, 30m…). Por defecto: 12h.
JWT_EXPIRES_IN="12h"

# --- API --------------------------------------------------------------------
# Puerto de la API HTTP. Por defecto: 3000.
PORT=3000
