# Plantilla de configuración de la API.
# Copia este fichero a `.env` (mismo directorio) y ajusta los valores.
# El `.env` real NO se versiona: contiene secretos.
#
#   cp apps/etiquetas-coolway-api/.env.example apps/etiquetas-coolway-api/.env

# --- Base de datos (maestro de códigos) -------------------------------------
# Postgres local vía Docker: `npm run db:up` desde la raíz.
# Credenciales de desarrollo definidas en docker-compose.yml (puerto host 5544).
DATABASE_URL="postgresql://coolway:coolway@localhost:5544/coolway_maestro?schema=public"

# --- Autenticación (JWT) ----------------------------------------------------
# Secreto con el que se firman los tokens de sesión.
# En local, si no se define, la API usa un secreto de desarrollo por defecto.
# OBLIGATORIO al desplegar: genera uno propio y no lo compartas.
#   openssl rand -base64 32
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Caducidad del token (formato `ms`: 12h, 7d, 30m…). Por defecto: 12h.
JWT_EXPIRES_IN="12h"

# --- API --------------------------------------------------------------------
# Puerto de la API HTTP. Por defecto: 3000.
PORT=3000

# --- RRHH · primer empleado de arranque -------------------------------------
# El módulo RRHH exige tener ficha de empleado para verlo, y sólo un empleado con rol de gestión puede dar de
# alta a otros: nadie podría crear el primero desde la UI. Esto enlaza un USUARIO YA EXISTENTE (por su correo)
# con una ficha de empleado con rol ADMIN. Idempotente: si ya tiene ficha, no hace nada. Tras el primer arranque
# se puede quitar. A partir de ahí, esa persona ya ve "Personas" y da de alta al resto.
#RRHH_BOOTSTRAP_EMAIL="tu-correo-de-login@grupoyorga.com"
#RRHH_BOOTSTRAP_NAME="Tu Nombre"

# --- Justificantes de ausencias · DigitalOcean Spaces (S3) ------------------
# Almacenamiento de los justificantes (dato sensible: se sirven por la API, sin URL pública).
# Si NO se definen, en desarrollo se usa disco local (carpeta uploads/, efímera) y en producción la
# subida queda deshabilitada (avisa, no pierde ficheros en silencio). Crea un Space y una key en DO.
#SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
#SPACES_REGION="fra1"
#SPACES_BUCKET="coolway-rrhh"
#SPACES_KEY="tu-access-key"
#SPACES_SECRET="tu-secret-key"
